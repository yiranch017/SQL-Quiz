# Copy to .env (never commit .env). Use the SESSION POOLER string from Supabase:
#   Project -> Connect -> Connection string -> Session pooler
# If the password contains special characters (@ : / ? # %), URL-encode them
# (python -c "import urllib.parse as u; print(u.quote('your password', safe=''))").
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-URL-ENCODED-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres
